# Salin ke .env.local lalu isi dengan kredensial project Supabase kamu.
# Ambil di dashboard Supabase: Project Settings > API.
#
# Tanpa prefix NEXT_PUBLIC_: nilainya dibaca server saat request, bukan ditanam
# ke bundle saat build. Di Vercel boleh disimpan bertipe Secret.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
